{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "DigitalDarziApi",
    "Audience": "DigitalDarziClients",
    "ExpiryHours": "24",
    "RefreshTokenDays": "30"
  },
  "Database": {
    "MigrateOnStartup": false,
    "CommandTimeoutSeconds": 30
