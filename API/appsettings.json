      "TemplateName": "",
      "TemplateLanguage": "en"
    },
    "Sms": {
      "Url": "",
      "ApiKey": "",
      "ApiKeyHeader": "Authorization",
      "SenderId": ""
    }
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
