  "Notifications": {
    "DispatcherEnabled": true,
    "PollSeconds": 10,
    "MaxAttempts": 5,
    "RemindersEnabled": true,
    "ReminderHour": 9,
    "DefaultCountryCode": "92",
    "WhatsApp": {
      "AccessToken": "",
      "PhoneNumberId": "",
